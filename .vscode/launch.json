{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "msedge",
            "request": "launch",
            "name": "Debug Client (Edge)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/client"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Client (Chrome)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/client"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Server (Wrangler)",
            "port": 9229,
            "cwd": "${workspaceFolder}/server",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "attachExistingChildren": false,
            "autoAttachChildProcesses": false,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                "Debug Client (Chrome)",
                "Attach to Server (Wrangler)"
            ]
        }
    ]
}
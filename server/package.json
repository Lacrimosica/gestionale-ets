{
  "name": "gestionale-server",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev":            "wrangler dev src/index.ts --inspector-port 9229",
    "dev:staging":    "wrangler dev src/index.ts --env staging --remote --inspector-port 9229",
    "dev:production": "wrangler dev src/index.ts --env production --remote --inspector-port 9229",
    "deploy:staging":    "wrangler deploy src/index.ts --env staging",
    "deploy":            "wrangler deploy src/index.ts --env production",
    "db:generate":          "drizzle-kit generate",
    "db:migrate":           "wrangler d1 migrations apply gestionale-ets-db --local",
    "db:migrate:staging":   "wrangler d1 migrations apply gestionale-ets-db-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply gestionale-ets-db --remote --env production"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "drizzle-zod": "^0.5.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "drizzle-kit": "^0.21.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.75.0"
  }
}

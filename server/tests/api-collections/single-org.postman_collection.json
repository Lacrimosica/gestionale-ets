{
  "info": {
    "_postman_id": "single-org-tests",
    "name": "Single-Org Mode API Tests",
    "description": "API contract tests for DEPLOYMENT_MODE=single_org. Verify that only one organization can be created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup Flow",
      "item": [
        {
          "name": "Get Setup Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/setup/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has token', function() {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.environment.set('setupToken', json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fresh Setup with Valid Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{setupToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"test-org-{{$timestamp}}\",\n  \"name\": \"Test Organization\",\n  \"shortName\": \"TestOrg\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup succeeds with 200 OK', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has organization', function() {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('organization');",
                  "  pm.expect(json.organization).to.have.property('id');",
                  "  pm.environment.set('orgId', json.organization.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Setup Status (Completed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/setup/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Setup is complete (needsSetup=false)', function() {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.needsSetup).to.equal(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Constraint Tests",
      "item": [
        {
          "name": "Duplicate Slug Returns 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{setupToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"test-org-{{$timestamp}}\",\n  \"name\": \"Another Org\",\n  \"shortName\": \"AnotherOrg\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second setup attempt returns 409 Conflict', function() {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Authorization Token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"another-org\",\n  \"name\": \"Another Org\",\n  \"shortName\": \"AnotherOrg\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing auth token returns 401', function() {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787",
      "type": "string"
    },
    {
      "key": "setupToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "",
      "type": "string"
    }
  ]
}
